 def change_email(request):
-    """Update the signed-in user's contact e-mail address."""
+    """Update the signed-in user's contact e-mail address.
+
+    Fixes CSRF (A3): the @csrf_exempt that disabled Django's token protection
+    has been removed, so this state-changing POST now requires a valid CSRF
+    token and the framework also verifies the request Origin/Referer against
+    CSRF_TRUSTED_ORIGINS. A tokenless cross-site POST is now rejected (403).
+    """
     if request.method != "POST":
         return JsonResponse({"detail": "POST required"}, status=405)
     new_email = request.POST.get("email", "")
@@ -1518,17 +1534,34 @@ def export_ticket(request, ticket_id):

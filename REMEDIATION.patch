-@helpdesk_staff_member_required
+@superuser_required
 def promote_user(request):
-    """Grant a user administrator rights."""
+    """Grant a user administrator rights.
+
+    Fixes vertical privilege escalation (A2): this administrative action now
+    requires an existing administrator (@superuser_required), not merely staff,
+    so a plain agent can no longer grant superuser rights.
+    """
